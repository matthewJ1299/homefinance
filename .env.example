# Auth (required for production)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Database: use one of the following.
# Postgres (for Docker Compose or Coolify with Postgres resource):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SQLite (default when DATABASE_URL is not set):
# DB_PATH=./data/sqlite.db

# Seed (optional)
# SEED_USER_PASSWORD=ChangeMe123!
# SEED_USER1_EMAIL=user1@homefinance.local
# SEED_USER2_EMAIL=user2@homefinance.local
# SEED_USER1_NAME=User One
# SEED_USER2_NAME=User Two

# Local only: add 3 months of sample transactions and income for testing. Do not set in production.
# SEED_SAMPLE_DATA=true

# Push notifications (required for push)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Generate with: npm run generate-vapid-keys

# Cron protection for GET /api/cron/daily-calendar-notification (recommended for production)
# CRON_SECRET=

# Timezone for scheduled notifications (daily 9am summary, per-event reminders). Default: UTC
# TZ=Africa/Johannesburg

# Optional: hour (0-23) for daily calendar summary. Default: 9
# DAILY_NOTIFICATION_HOUR=9

# Optional: Gemini API key for AI expense analysis on the dashboard. If unset, the Analyze spending button is hidden.
# GEMINI_API_KEY=AIzaSyAQZfyFacIRPua_-3M4WaZJJzMG_wu9MjQ

AUTH_SECRET=dev-secret-change-in-production
SEED_SAMPLE_DATA=true